---
/** Interactive companion to the random-matrix animation: drag N and watch the
 *  empirical eigenvalue density (navy) morph toward the Wigner semicircle (amber).
 *  Data is exported at build time by scripts/data/export.R. */
---

<figure data-semicircle class="mt-10">
  <div class="overflow-hidden rounded-xl border border-line bg-panel">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line bg-panel-2/60 px-4 py-3">
      <div class="flex items-center gap-3">
        <span class="text-[13px] font-medium text-muted">Matrix size</span>
        <span class="tnum rounded-md bg-navy/10 px-2 py-0.5 font-mono text-[13px] font-semibold text-accent">
          N = <span data-n-label>13</span>
        </span>
      </div>
      <input
        data-n-slider
        type="range"
        min="0"
        max="11"
        value="4"
        step="1"
        aria-label="Matrix size N"
        class="h-1.5 w-44 cursor-pointer appearance-none rounded-full bg-line accent-navy sm:w-56"
      />
    </div>
    <div data-plot class="px-3 py-3 text-muted"></div>
  </div>
  <figcaption class="mt-3 text-[13px] leading-relaxed text-faint">
    Drag to grow the matrix. Even by N&nbsp;=&nbsp;30 the random spectrum (navy) has all
    but settled onto the limiting semicircle (amber) — the same convergence the
    animation above sweeps through automatically.
  </figcaption>
</figure>

<script>
  import * as Plot from '@observablehq/plot';

  function initSemicircle() {
    const root = document.querySelector<HTMLElement>('[data-semicircle]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';

    const slider = root.querySelector<HTMLInputElement>('[data-n-slider]')!;
    const label = root.querySelector<HTMLElement>('[data-n-label]')!;
    const plotDiv = root.querySelector<HTMLElement>('[data-plot]')!;

    fetch('/data/semicircle-density.json')
      .then((r) => r.json())
      .then((data: { x: number[]; semicircle: number[]; curves: { N: number; y: number[] }[] }) => {
        slider.max = String(data.curves.length - 1);
        const semi = data.x.map((xi, i) => ({ x: xi, y: data.semicircle[i] }));

        const render = () => {
          const cur = data.curves[+slider.value];
          label.textContent = String(cur.N);
          const density = data.x.map((xi, i) => ({ x: xi, y: cur.y[i] }));
          const fig = Plot.plot({
            height: 340,
            marginLeft: 50,
            marginBottom: 38,
            style: { background: 'transparent', color: 'currentColor', fontSize: '12px' },
            x: { label: 'eigenvalue (scaled) →', domain: [-2.6, 2.6] },
            y: { label: '↑ density', domain: [0, 0.42] },
            marks: [
              Plot.areaY(density, { x: 'x', y: 'y', fill: '#215e99', fillOpacity: 0.85, curve: 'basis' }),
              Plot.lineY(semi, { x: 'x', y: 'y', stroke: '#c2410c', strokeWidth: 2.5, curve: 'basis' }),
              Plot.ruleY([0], { stroke: 'currentColor', strokeOpacity: 0.25 }),
            ],
          });
          plotDiv.replaceChildren(fig);
        };

        slider.addEventListener('input', render);
        render();
      })
      .catch(() => {});
  }

  document.addEventListener('astro:page-load', initSemicircle);
  if (document.readyState !== 'loading') initSemicircle();
  else document.addEventListener('DOMContentLoaded', initSemicircle);
</script>
