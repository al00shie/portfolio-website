---
/**
 * Accessible, performance-conscious autoplay animation.
 * - Ships WebM + MP4 (no GIF) with a poster; explicit aspect-ratio => no CLS.
 * - preload="none" + IntersectionObserver defers the bytes (loading="lazy"
 *   does NOT defer <video> in any browser).
 * - No `autoplay` attribute: playback is started in JS only when motion is
 *   allowed, so prefers-reduced-motion users get the still poster instead.
 * - A real pause/play button satisfies WCAG 2.2.2 for the >5s loop.
 */
interface Props {
  webm: string;
  mp4: string;
  poster: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}
const { webm, mp4, poster, alt, caption, width = 900, height = 560 } = Astro.props;
---

<figure class="mt-10">
  <div
    class="group relative overflow-hidden rounded-xl border border-line bg-white"
    style={`aspect-ratio:${width} / ${height}`}
  >
    <video
      class="h-full w-full object-cover"
      data-motion-video
      muted
      loop
      playsinline
      preload="none"
      poster={poster}
      width={width}
      height={height}
      aria-label={alt}
    >
      <source data-src={webm} type="video/webm" />
      <source data-src={mp4} type="video/mp4" />
    </video>

    <button
      type="button"
      data-motion-toggle
      class="absolute bottom-3 right-3 z-10 inline-flex h-8 w-8 items-center justify-center rounded-full border border-line/60 bg-surface/75 text-muted opacity-70 backdrop-blur-md transition-opacity hover:text-accent hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-label="Pause animation"
      aria-pressed="false"
    >
      <svg data-icon-pause class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
      <svg data-icon-play class="hidden h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
    </button>
  </div>
  {caption && <figcaption class="mt-3 text-[13px] leading-relaxed text-faint">{caption}</figcaption>}
</figure>

<script>
  function initMotionVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-motion-video]');
    if (!videos.length) return;
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');

    const loadSources = (v: HTMLVideoElement) => {
      if (v.dataset.loaded) return;
      v.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => {
        if (s.dataset.src) s.src = s.dataset.src;
      });
      v.load();
      v.dataset.loaded = '1';
    };

    videos.forEach((v) => {
      if (v.dataset.motionInit) return;
      v.dataset.motionInit = '1';
      v.muted = true; // set the muted *property* explicitly — the attribute alone can be unreliable after a View-Transition DOM swap, which would block muted autoplay

      const wrap = v.closest('.group');
      const toggle = wrap?.querySelector<HTMLButtonElement>('[data-motion-toggle]');
      const pauseIcon = toggle?.querySelector('[data-icon-pause]');
      const playIcon = toggle?.querySelector('[data-icon-play]');
      let userPaused = false;

      const sync = () => {
        if (!toggle) return;
        const paused = v.paused;
        pauseIcon?.classList.toggle('hidden', paused);
        playIcon?.classList.toggle('hidden', !paused);
        toggle.setAttribute('aria-pressed', String(paused));
        toggle.setAttribute('aria-label', paused ? 'Play animation' : 'Pause animation');
      };

      const play = () => {
        if (userPaused || mq.matches) return;
        loadSources(v);
        v.play().catch(() => {});
      };

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => (e.isIntersecting ? play() : v.pause())),
          { rootMargin: '200px 0px' },
        );
        io.observe(v);
      } else {
        play();
      }

      toggle?.addEventListener('click', () => {
        if (v.paused) {
          userPaused = false;
          loadSources(v);
          v.play().catch(() => {});
        } else {
          userPaused = true;
          v.pause();
        }
      });
      v.addEventListener('play', sync);
      v.addEventListener('pause', sync);

      if (mq.addEventListener) {
        mq.addEventListener('change', () => (mq.matches ? v.pause() : play()));
      }
      sync();
    });
  }

  document.addEventListener('astro:page-load', initMotionVideos);
  if (document.readyState !== 'loading') initMotionVideos();
  else document.addEventListener('DOMContentLoaded', initMotionVideos);
</script>
