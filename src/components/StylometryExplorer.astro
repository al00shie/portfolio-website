---
/** Interactive scatter of the harmonic-stylometry feature space: pick any two
 *  features for the axes, points colored by composer, hover for details.
 *  Data exported at build time by scripts/data/export.R. */
const features = [
  { key: 'dissonance', label: 'Dissonance' },
  { key: 'consonance', label: 'Consonance' },
  { key: 'interchange', label: 'Modal interchange' },
  { key: 'borrowed_sub', label: 'Borrowed subs' },
  { key: 'blues', label: 'Blues inflection' },
];
---

<figure data-stylometry class="mt-10">
  <div class="overflow-hidden rounded-xl border border-line bg-panel">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-b border-line bg-panel-2/60 px-4 py-3">
      <label class="flex items-center gap-2 text-[13px] text-muted">
        <span class="font-medium">X</span>
        <select data-x class="rounded-md border border-line bg-panel px-2 py-1 text-[13px] text-fg outline-none focus-visible:border-accent">
          {features.map((f) => <option value={f.key} selected={f.key === 'dissonance'}>{f.label}</option>)}
        </select>
      </label>
      <label class="flex items-center gap-2 text-[13px] text-muted">
        <span class="font-medium">Y</span>
        <select data-y class="rounded-md border border-line bg-panel px-2 py-1 text-[13px] text-fg outline-none focus-visible:border-accent">
          {features.map((f) => <option value={f.key} selected={f.key === 'interchange'}>{f.label}</option>)}
        </select>
      </label>
    </div>
    <div data-plot class="px-3 py-3 text-muted"></div>
  </div>
  <figcaption class="mt-3 text-[13px] leading-relaxed text-faint">
    Each point is one piece, placed by two harmonic features and colored by composer
    — hover for details. Switch the axes to see which feature pairs pull the composers
    apart; that separability is exactly what the classifier learns from.
  </figcaption>
</figure>

<script>
  import * as Plot from '@observablehq/plot';

  const LABELS: Record<string, string> = {
    dissonance: 'Dissonance', consonance: 'Consonance', interchange: 'Modal interchange',
    borrowed_sub: 'Borrowed subs', blues: 'Blues inflection',
  };
  const PALETTE = ['#215e99', '#c2410c', '#0e7490', '#7c3aed', '#15803d', '#b45309'];

  function initStylometry() {
    const root = document.querySelector<HTMLElement>('[data-stylometry]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';

    const xSel = root.querySelector<HTMLSelectElement>('[data-x]')!;
    const ySel = root.querySelector<HTMLSelectElement>('[data-y]')!;
    const plotDiv = root.querySelector<HTMLElement>('[data-plot]')!;

    fetch('/data/composers.json')
      .then((r) => r.json())
      .then((rows: Record<string, any>[]) => {
        const composers = Array.from(new Set(rows.map((d) => d.composer))).sort();
        const render = () => {
          const fx = xSel.value, fy = ySel.value;
          const fig = Plot.plot({
            height: 420,
            marginLeft: 54,
            marginBottom: 46,
            grid: true,
            style: { background: 'transparent', color: 'currentColor', fontSize: '12px' },
            x: { label: `${LABELS[fx]} →` },
            y: { label: `↑ ${LABELS[fy]}` },
            color: { legend: true, domain: composers, range: PALETTE },
            marks: [
              Plot.dot(rows, {
                x: fx, y: fy, fill: 'composer', r: 4.5, fillOpacity: 0.82,
                stroke: 'currentColor', strokeOpacity: 0.12,
                tip: true, channels: { composer: 'composer' },
              }),
            ],
          });
          plotDiv.replaceChildren(fig);
        };
        xSel.addEventListener('change', render);
        ySel.addEventListener('change', render);
        render();
      })
      .catch(() => {});
  }

  document.addEventListener('astro:page-load', initStylometry);
  if (document.readyState !== 'loading') initStylometry();
  else document.addEventListener('DOMContentLoaded', initStylometry);
</script>
