---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Homepage feature-panel variant: larger serif title, roomier text. */
  large?: boolean;
}

const { project, large = false } = Astro.props;
const d = project.data;
const href = `/projects/${project.id}`;
const tags = d.methods.slice(0, 3);
const thumb = d.images.find((i) => i.thumbnail) ?? d.images[0];
---

<!-- Unboxed panel, salo-style: crop-framed figure, condensed method kicker,
     serif title, CTA with the underline wipe. The whole card is the link;
     hover choreography lives in global.css under .project-panel. -->
<a
  href={href}
  class="project-panel group flex flex-col focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
  data-reveal
>
  <span class="panel-media block overflow-hidden rounded-lg border border-line bg-white">
    {thumb && (
      <img
        src={thumb.src}
        alt={thumb.alt}
        loading="lazy"
        decoding="async"
        class="aspect-[16/10] w-full object-cover"
      />
    )}
  </span>

  {
    tags.length > 0 && (
      <p class="mt-5 font-condensed text-[12.5px] font-bold uppercase tracking-[0.12em] text-accent">
        {tags.join(' · ')}
      </p>
    )
  }

  <h3
    class={`panel-title mt-1.5 font-display font-medium leading-snug text-fg ${large ? 'text-[1.7rem] sm:text-[1.9rem]' : 'text-[1.45rem]'}`}
    transition:name={`title-${project.id}`}
  >
    {d.title}
  </h3>

  <p class={`mt-2 leading-relaxed text-muted ${large ? 'text-[15.5px]' : 'text-[14.5px]'}`}>{d.tagline}</p>

  <span class="card-cta mt-3 inline-flex items-center gap-1.5 self-start text-[13.5px] font-semibold text-accent">
    View Project
    <svg
      class="cta-arrow h-4 w-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </span>
</a>
