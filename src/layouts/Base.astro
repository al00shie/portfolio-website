---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ali Taqi — Quantitative Analyst & Actuarial Candidate',
  description = 'Portfolio of Ali Taqi: actuarial candidate (Exam P & FM) and quantitative analyst. Statistics, probability, and machine-learning projects from Boston University and Reed College.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://alitaqi.pages.dev');
const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="author" content="Ali Taqi" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- No-flash theme resolution before first paint -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          var dark = t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.add(dark ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.classList.add('light');
        }
      })();
    </script>
  </head>

  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >

    <header
      class="sticky top-0 z-40 border-b border-line/70 bg-surface/80 backdrop-blur-md"
    >
      <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-8">
        <a href="/" class="group flex items-center gap-2.5" aria-label="Ali Taqi — home">
          <span
            class="grid h-8 w-8 place-items-center rounded-md bg-navy text-[13px] font-bold tracking-tight text-white"
            >AT</span
          >
          <span class="text-[15px] font-semibold tracking-tight">Ali Taqi</span>
        </a>

        <nav class="flex items-center gap-1 sm:gap-2">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="rounded-md px-3 py-2 text-[14px] font-medium text-muted transition-colors hover:text-fg"
              >
                {item.label}
              </a>
            ))
          }
          <span class="mx-1 hidden h-5 w-px bg-line sm:block"></span>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div
        class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-5 py-10 text-[13.5px] text-muted sm:flex-row sm:px-8"
      >
        <p>© {new Date().getFullYear()} Ali Taqi</p>
        <div class="flex items-center gap-5">
          <a class="transition-colors hover:text-accent" href="mailto:alif.taqi00@gmail.com">Email</a>
          <a class="transition-colors hover:text-accent" href="https://github.com/al00shie" target="_blank" rel="noopener">GitHub</a>
          <a class="transition-colors hover:text-accent" href="/#work">Work</a>
        </div>
      </div>
    </footer>
  </body>
</html>
