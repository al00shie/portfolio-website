---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import content from '../../content.yaml';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// All copy lives in /content.yaml — edit it there.
const { site, work } = content;
---

<Base title={`Work — ${site.name}`} description={work.blurb}>
  <section id="work" class="scroll-mt-20">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="reveal max-w-2xl" style="animation-delay:50ms">
        <p
          class="font-condensed text-[14px] font-bold uppercase tracking-[0.12em] text-accent before:mb-5 before:block before:h-[2px] before:w-12 before:bg-accent before:content-['']"
        >
          {work.eyebrow}
        </p>
        <h1 class="mt-3 font-display text-3xl font-medium sm:text-4xl">{work.heading}</h1>
        <p class="mt-4 text-[16px] leading-relaxed text-muted">{work.blurb}</p>
      </div>

      <div class="work-grid mt-14 grid grid-cols-1 gap-x-8 gap-y-14 md:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</Base>
