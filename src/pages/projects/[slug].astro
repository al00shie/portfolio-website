---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Animation from '../../components/Animation.astro';

export async function getStaticPaths() {
  const sorted = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const meta = [d.school, d.credential, d.course, d.year, d.role].filter(Boolean);
---

<Base title={`${d.title} — Ali Taqi`} description={d.summary}>
  <article class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-16">
    <a
      href="/#work"
      class="inline-flex items-center gap-1.5 text-[13.5px] font-medium text-muted transition-colors hover:text-accent"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
      All Work
    </a>

    <header class="mt-7">
      <p class="text-[12.5px] font-medium uppercase tracking-wider text-faint">
        {meta.join(' · ')}
      </p>
      <h1 class="mt-3 text-balance text-3xl font-bold leading-tight tracking-tight sm:text-[2.6rem]" transition:name={`title-${project.id}`}>
        {d.title}
      </h1>
      <p class="mt-4 text-[17px] leading-relaxed text-muted">{d.summary}</p>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          d.paper && (
            <a
              href={d.paper}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-lg bg-navy px-4 py-2.5 text-[14px] font-semibold text-white transition-transform hover:-translate-y-0.5"
            >
              <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M9 13h6M9 17h6" /></svg>
              Read the Report
            </a>
          )
        }
        {
          d.repo && (
            <a
              href={d.repo}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-lg border border-line px-4 py-2.5 text-[14px] font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
            >
              <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.4-1.27.74-1.56-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z" /></svg>
              View Code
            </a>
          )
        }
        {
          d.liveCode && (
            <a
              href={d.liveCode}
              class="inline-flex items-center gap-2 rounded-lg border border-accent bg-accent-soft px-4 py-2.5 text-[14px] font-semibold text-accent transition-transform hover:-translate-y-0.5"
            >
              <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3" /><path d="m10 9 4 3-4 3z" /></svg>
              Run it Live
            </a>
          )
        }
        {
          d.liveDemo && (
            <a
              href={d.liveDemo}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-lg border border-line px-4 py-2.5 text-[14px] font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
            >
              Live Demo
            </a>
          )
        }
      </div>
    </header>

    {
      d.animation ? (
        <Animation
          webm={d.animation.webm}
          mp4={d.animation.mp4}
          poster={d.animation.poster}
          alt={d.animation.alt}
          caption={d.animation.caption}
          width={d.animation.width}
          height={d.animation.height}
        />
      ) : (
        <figure class="mt-10">
          <div class="overflow-hidden rounded-xl border border-line bg-white">
            <img src={d.image} alt={d.imageAlt} class="w-full" />
          </div>
          <figcaption class="mt-3 text-[13px] leading-relaxed text-faint">{d.imageAlt}</figcaption>
        </figure>
      )
    }

    <div class="mt-9 flex flex-wrap gap-2">
      {
        d.methods.map((m) => (
          <span class="rounded-full border border-line bg-panel-2 px-3 py-1 text-[12.5px] font-medium text-muted">{m}</span>
        ))
      }
    </div>

    {
      d.collaborators.length > 0 && (
        <p class="mt-6 text-[14px] text-muted">
          <span class="font-semibold text-fg">Collaborators:</span> {d.collaborators.join(', ')}
        </p>
      )
    }

    <div class="article mt-8">
      <Content />
    </div>

    <!-- Prev / next -->
    <nav class="mt-16 grid grid-cols-1 gap-4 border-t border-line pt-8 sm:grid-cols-2">
      {
        prev ? (
          <a href={`/projects/${prev.id}`} class="group rounded-lg border border-line p-4 transition-colors hover:border-accent/60">
            <p class="text-[12px] font-medium uppercase tracking-wider text-faint">← Previous</p>
            <p class="mt-1 font-semibold text-fg group-hover:text-accent">{prev.data.title}</p>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/projects/${next.id}`} class="group rounded-lg border border-line p-4 text-right transition-colors hover:border-accent/60 sm:col-start-2">
            <p class="text-[12px] font-medium uppercase tracking-wider text-faint">Next →</p>
            <p class="mt-1 font-semibold text-fg group-hover:text-accent">{next.data.title}</p>
          </a>
        )
      }
    </nav>
  </article>
</Base>
