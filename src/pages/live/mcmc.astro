---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Live app — Bayesian MCMC sampler | Ali Taqi"
  description="A full Shiny app running with no server: tune the priors and proposal width of a Metropolis MCMC sampler and watch the Bayesian posterior move. R compiled to WebAssembly via Shinylive."
>
  <section class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-16">
    <a
      href="/projects/poisson-three-ways"
      class="inline-flex items-center gap-1.5 text-[13.5px] font-medium text-muted transition-colors hover:text-accent"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
      Poisson Regression, Three Ways
    </a>

    <header class="mt-7">
      <p class="font-condensed text-[13px] font-bold uppercase tracking-[0.12em] text-muted">Live app · Shinylive</p>
      <h1 class="mt-3 text-balance font-display text-3xl font-medium leading-[1.15] sm:text-[2.5rem]">
        Tune the priors. Watch the posterior move.
      </h1>
      <p class="mt-4 text-[16.5px] leading-relaxed text-muted">
        This is a complete <strong class="text-fg">Shiny app with no server</strong> — R itself is compiled to
        WebAssembly and runs in your browser via
        <a class="text-accent underline underline-offset-2" href="https://shiny.posit.co/py/docs/shinylive.html" target="_blank" rel="noopener">Shinylive</a>.
        Drag the sliders to change the prior and the proposal width, press <strong class="text-fg">Sample</strong>,
        and the hand-coded Metropolis sampler redraws the Bayesian posterior live.
      </p>
    </header>

    <div data-shinylive class="mt-8">
      <div class="rounded-xl border border-line bg-panel p-6 text-center">
        <p class="text-[14px] text-muted">
          Heads-up: this ships an entire R runtime, so the first load is a one-time
          <span class="tnum font-semibold text-fg">~60&nbsp;MB</span> download (best on desktop / Wi-Fi).
          It loads only when you ask.
        </p>
        <button
          type="button"
          data-launch
          class="mt-4 inline-flex items-center gap-2 rounded-lg bg-navy px-5 py-2.5 text-[14.5px] font-semibold text-white transition-all hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-70"
        >
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
          <span data-launch-label>Launch the live app</span>
        </button>
      </div>
      <div data-frame-wrap class="mt-4 hidden"></div>
    </div>

    <p class="mt-8 text-[13px] leading-relaxed text-faint">
      Prefer something lighter? The same sampler runs as a one-shot base-R cell on the
      <a class="text-accent underline underline-offset-2" href="/live/random-matrix">WebR page</a>,
      and as the autoplay animation on the
      <a class="text-accent underline underline-offset-2" href="/projects/poisson-three-ways">project page</a>.
    </p>
  </section>
</Base>

<script>
  function initShinylive() {
    const root = document.querySelector<HTMLElement>('[data-shinylive]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';

    const btn = root.querySelector<HTMLButtonElement>('[data-launch]')!;
    const label = root.querySelector<HTMLElement>('[data-launch-label]')!;
    const wrap = root.querySelector<HTMLElement>('[data-frame-wrap]')!;

    btn.addEventListener('click', () => {
      btn.disabled = true;
      label.textContent = 'Loading R runtime — this can take a moment…';
      const frame = document.createElement('iframe');
      frame.src = '/live/mcmc-app/index.html';
      frame.title = 'Interactive Bayesian MCMC sampler (Shinylive)';
      frame.className = 'w-full rounded-xl border border-line bg-white';
      frame.style.height = '760px';
      frame.setAttribute('loading', 'lazy');
      frame.addEventListener('load', () => { label.textContent = 'Live app loaded'; });
      wrap.replaceChildren(frame);
      wrap.classList.remove('hidden');
    });
  }

  document.addEventListener('astro:page-load', initShinylive);
  if (document.readyState !== 'loading') initShinylive();
  else document.addEventListener('DOMContentLoaded', initShinylive);
</script>
