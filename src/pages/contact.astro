---
import Base from '../layouts/Base.astro';
import content from '../../content.yaml';

// All copy lives in /content.yaml — edit it there (contact.showForm hides
// the form; the buttons stay either way).
const { site, contact } = content;

const labelClass = 'block font-condensed text-[14.5px] font-bold uppercase tracking-[0.08em] text-fg';
const fieldClass =
  'mt-2 w-full rounded-md border border-line bg-panel px-3.5 py-2.5 text-[15px] text-fg focus:outline-2 focus:outline-offset-1 focus:outline-accent';
---

<Base title={`Contact — ${site.name}`} description={contact.blurb}>
  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="reveal" style="animation-delay:50ms">
      <p
        class="font-condensed text-[14px] font-bold uppercase tracking-[0.12em] text-accent before:mb-5 before:block before:h-[2px] before:w-12 before:bg-accent before:content-['']"
      >
        {contact.eyebrow}
      </p>
      <h1 class="mt-3 font-display text-3xl font-medium sm:text-4xl">{contact.heading}</h1>
      <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-muted">{contact.blurb}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 rounded-lg bg-navy px-5 py-2.5 text-[14.5px] font-semibold text-white transition-transform hover:-translate-y-0.5"
        >
          {site.email}
        </a>
        <a
          href={site.github}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-2.5 text-[14.5px] font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
        >
          GitHub
        </a>
      </div>
    </div>

    {
      contact.showForm && (
        <form
          class="reveal mt-14 max-w-xl border-t border-line/70 pt-10"
          style="animation-delay:150ms"
          data-contact-form
          data-contact-email={site.email}
        >
          <div class="space-y-6">
            <div>
              <label class={labelClass} for="cf-name">
                {contact.form.name}
              </label>
              <input class={fieldClass} id="cf-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div>
              <label class={labelClass} for="cf-email">
                {contact.form.email}
              </label>
              <input class={fieldClass} id="cf-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div>
              <label class={labelClass} for="cf-message">
                {contact.form.message}
              </label>
              <textarea class={fieldClass} id="cf-message" name="message" rows="6" required />
            </div>
          </div>
          <button
            type="submit"
            class="mt-8 inline-flex items-center gap-2 rounded-lg bg-navy px-6 py-2.5 text-[14.5px] font-semibold text-white transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {contact.form.send}
            <span class="cta-arrow" aria-hidden="true">→</span>
          </button>
          <p class="mt-4 text-[13px] leading-relaxed text-faint">
            Sending opens a pre-filled email in your own mail app — nothing is stored here.
          </p>
        </form>
      )
    }
  </section>

  <!-- Composes the message in the visitor's own mail client: no backend, no
       third-party form service, nothing stored. Bound once on document so it
       survives View Transitions swaps. -->
  <script is:inline>
    (function () {
      if (window.__contactFormBound) return;
      window.__contactFormBound = true;
      document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-contact-form')) return;
        e.preventDefault();
        var data = new FormData(form);
        var name = String(data.get('name') || '');
        var email = String(data.get('email') || '');
        var message = String(data.get('message') || '');
        var to = form.getAttribute('data-contact-email') || '';
        var subject = 'Website message from ' + name;
        var body = message + '\n\n— ' + name + ' (' + email + ')';
        window.location.href =
          'mailto:' + to + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      });
    })();
  </script>
</Base>
