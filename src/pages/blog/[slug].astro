---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const sorted = (await getCollection('posts'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // "newer" is the post above this one in the (newest-first) index, "older" the one below
      newer: sorted[i - 1] ?? null,
      older: sorted[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const d = post.data;
const { Content } = await render(post);

const fmtDate = d.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 220));
---

<Base title={`${d.title} — Ali Taqi`} description={d.tagline}>
  <article class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-16">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-[13.5px] font-medium text-muted transition-colors hover:text-accent"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
      All Posts
    </a>

    <header class="mt-7">
      <h1
        class="text-balance text-3xl font-bold leading-tight tracking-tight sm:text-[2.6rem]"
        transition:name={`post-title-${post.id}`}
      >
        {d.title}
      </h1>
      <p class="mt-4 text-[17px] leading-relaxed text-muted">{d.tagline}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-[13.5px] text-faint">
        <time datetime={d.date.toISOString().slice(0, 10)} class="tnum font-medium">{fmtDate}</time>
        <span aria-hidden="true">·</span>
        <span class="tnum">{minutes} min read</span>
        {
          d.tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span class="flex flex-wrap gap-2">
                {d.tags.map((t) => (
                  <span class="rounded-full border border-line bg-panel-2 px-2.5 py-0.5 text-[12px] font-medium text-muted">
                    {t}
                  </span>
                ))}
              </span>
            </>
          )
        }
      </div>
    </header>

    <div class="article mt-10">
      <Content />
    </div>

    <!-- Newer / older -->
    {
      (newer || older) && (
        <nav class="mt-16 grid grid-cols-1 gap-4 border-t border-line pt-8 sm:grid-cols-2">
          {newer ? (
            <a href={`/blog/${newer.id}`} class="group rounded-lg border border-line p-4 transition-colors hover:border-accent/60">
              <p class="text-[12px] font-medium uppercase tracking-wider text-faint">← Newer</p>
              <p class="mt-1 font-semibold text-fg group-hover:text-accent">{newer.data.title}</p>
            </a>
          ) : (
            <span />
          )}
          {older && (
            <a href={`/blog/${older.id}`} class="group rounded-lg border border-line p-4 text-right transition-colors hover:border-accent/60 sm:col-start-2">
              <p class="text-[12px] font-medium uppercase tracking-wider text-faint">Older →</p>
              <p class="mt-1 font-semibold text-fg group-hover:text-accent">{older.data.title}</p>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>
