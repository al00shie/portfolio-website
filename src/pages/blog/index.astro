---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Blog — Ali Taqi" description="Occasional writing by Ali Taqi — mostly where statistics runs into music, risk, and other things worth measuring.">
  <section class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-16">
    <h1 class="text-3xl font-bold leading-tight tracking-tight sm:text-[2.6rem]">Blog</h1>
    <p class="mt-4 text-[17px] leading-relaxed text-muted">
      Occasional writing — mostly where statistics runs into music, risk, and other things worth
      measuring.
    </p>

    <ul class="mt-10 divide-y divide-line border-t border-line">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group block py-7">
              <time
                datetime={post.data.date.toISOString().slice(0, 10)}
                class="tnum text-[13px] font-medium uppercase tracking-wider text-faint"
              >
                {fmtDate(post.data.date)}
              </time>
              <h2
                class="mt-1.5 text-[1.35rem] font-bold leading-snug tracking-tight transition-colors group-hover:text-accent"
                transition:name={`post-title-${post.id}`}
              >
                {post.data.title}
              </h2>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{post.data.tagline}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
