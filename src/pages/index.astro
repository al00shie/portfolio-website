---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import content from '../../content.yaml';

// The two lowest-order projects headline the homepage, salo-panel style.
const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

// All homepage copy lives in /content.yaml — edit it there.
const { site, hero, exams, work, contact } = content;

// The headline doubles as the roles line under the name — "A & B" renders
// as "A · B" with accent dots, salo-hero style.
const roles = hero.headline.split(' & ');
---

<Base>
  <!-- ───────────────────────── Hero ───────────────────────── -->
  <section class="relative">
    <div class="mx-auto max-w-5xl px-5 pb-20 pt-20 sm:px-8 sm:pb-24 sm:pt-28">
      {
        hero.eyebrow && (
          <p class="reveal font-condensed text-[14px] font-bold uppercase tracking-[0.12em] text-accent">
            {hero.eyebrow}
          </p>
        )
      }

      <h1
        class="reveal mt-2 font-display text-5xl font-medium leading-[1.04] text-fg after:mt-8 after:block after:h-[2px] after:w-16 after:bg-accent after:content-[''] sm:text-6xl md:text-7xl"
        style="animation-delay:50ms"
      >
        {site.name}
      </h1>

      <p
        class="reveal mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 font-display text-xl text-fg sm:text-2xl"
        style="animation-delay:130ms"
      >
        {
          roles.map((r, i) => (
            <>
              {i > 0 && (
                <span class="text-[1.3em] leading-none text-accent" aria-hidden="true">
                  ·
                </span>
              )}
              <span>{r}</span>
            </>
          ))
        }
      </p>

      <p
        class="reveal mt-7 max-w-2xl text-[17px] leading-relaxed text-muted sm:text-lg"
        style="animation-delay:210ms"
      >
        {hero.intro}
      </p>

      <div
        class="reveal mt-8 flex flex-wrap items-center gap-2.5"
        style="animation-delay:290ms"
      >
        {
          exams.map((e) => (
            <span class="tnum inline-flex items-center gap-2 rounded-full border border-line bg-panel px-3.5 py-1.5 text-[13.5px]">
              {e.passed ? (
                <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              ) : (
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-faint" />
              )}
              <span class="font-semibold text-fg">{e.name}</span>
              <span class="text-faint">{e.note}</span>
            </span>
          ))
        }
      </div>

      <div
        class="reveal mt-9 flex flex-wrap items-center gap-3"
        style="animation-delay:370ms"
      >
        <a
          href="/work"
          class="inline-flex items-center gap-2 rounded-lg bg-navy px-5 py-2.5 text-[14.5px] font-semibold text-white transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          View Work
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-2.5 text-[14.5px] font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
        >
          Email
        </a>
        <a
          href={site.github}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-2.5 text-[14.5px] font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
        >
          GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- ─────────────── Feature panels (salo-style pair) ─────────────── -->
  <section class="border-t border-line/70">
    <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8 sm:py-24">
      <p
        class="font-condensed text-[14px] font-bold uppercase tracking-[0.12em] text-accent before:mb-5 before:block before:h-[2px] before:w-12 before:bg-accent before:content-['']"
        data-reveal
      >
        {work.eyebrow}
      </p>

      <div class="work-grid mt-10 grid grid-cols-1 gap-x-8 gap-y-14 md:grid-cols-2">
        {featured.map((project) => <ProjectCard project={project} large />)}
      </div>

      <p class="mt-14" data-reveal>
        <a
          href="/work"
          class="wipe inline-flex items-center gap-1.5 font-condensed text-[16px] font-bold text-accent"
        >
          Browse all seven projects
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ───────────────────────── Coda ────────────────────────── -->
  <section class="border-t border-line/70">
    <div class="mx-auto max-w-3xl px-5 py-20 text-center sm:px-8 sm:py-24" data-reveal>
      <h2 class="font-display text-3xl font-medium sm:text-4xl">{contact.heading}</h2>
      <p class="mt-6">
        <a
          href="/contact"
          class="wipe inline-flex items-center gap-1.5 font-condensed text-[16px] font-bold text-accent"
        >
          Get in touch
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>
</Base>
