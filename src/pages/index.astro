---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import content from '../../content.yaml';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// All homepage copy lives in /content.yaml — edit it there.
const { site, hero, exams, work, skills, about, education, experience, contact } = content;

// The headline doubles as the roles line under the name — "A & B" renders
// as "A · B" with accent dots, salo-hero style.
const roles = hero.headline.split(' & ');

// Shared eyebrow treatment: condensed uppercase kicker with a short accent
// rule above it (centered variant for the contact coda).
const eyebrowClass =
  "font-condensed text-[14px] font-bold uppercase tracking-[0.12em] text-accent before:mb-5 before:block before:h-[2px] before:w-12 before:bg-accent before:content-['']";
---

<Base>
  <!-- ───────────────────────── Hero ───────────────────────── -->
  <section class="relative">
    <div class="mx-auto max-w-5xl px-5 pb-16 pt-20 sm:px-8 sm:pb-20 sm:pt-28">
      {
        hero.eyebrow && (
          <p class="reveal font-condensed text-[14px] font-bold uppercase tracking-[0.12em] text-accent">
            {hero.eyebrow}
          </p>
        )
      }

      <h1
        class="reveal mt-2 font-display text-5xl font-medium leading-[1.04] text-fg after:mt-8 after:block after:h-[2px] after:w-16 after:bg-accent after:content-[''] sm:text-6xl md:text-7xl"
        style="animation-delay:50ms"
      >
        {site.name}
      </h1>

      <p
        class="reveal mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 font-display text-xl text-fg sm:text-2xl"
        style="animation-delay:130ms"
      >
        {
          roles.map((r, i) => (
            <>
              {i > 0 && (
                <span class="text-[1.3em] leading-none text-accent" aria-hidden="true">
                  ·
                </span>
              )}
              <span>{r}</span>
            </>
          ))
        }
      </p>

      <p
        class="reveal mt-7 max-w-2xl text-[17px] leading-relaxed text-muted sm:text-lg"
        style="animation-delay:210ms"
      >
        {hero.intro}
      </p>

      <div
        class="reveal mt-8 flex flex-wrap items-center gap-2.5"
        style="animation-delay:290ms"
      >
        {
          exams.map((e) => (
            <span class="tnum inline-flex items-center gap-2 rounded-full border border-line bg-panel px-3.5 py-1.5 text-[13.5px]">
              {e.passed ? (
                <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              ) : (
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-faint" />
              )}
              <span class="font-semibold text-fg">{e.name}</span>
              <span class="text-faint">{e.note}</span>
            </span>
          ))
        }
      </div>

      <div
        class="reveal mt-9 flex flex-wrap items-center gap-3"
        style="animation-delay:370ms"
      >
        <a
          href="#work"
          class="inline-flex items-center gap-2 rounded-lg bg-navy px-5 py-2.5 text-[14.5px] font-semibold text-white transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          View Work
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
        </a>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-2.5 text-[14.5px] font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
        >
          Email
        </a>
        <a
          href={site.github}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-2.5 text-[14.5px] font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
        >
          GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── About ──────────────────────── -->
  <section id="about" class="scroll-mt-20 border-t border-line/70">
    <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8 sm:py-24">
      <div class="grid grid-cols-1 gap-14 lg:grid-cols-[1fr_1.15fr]">
        <div class="max-w-md" data-reveal>
          <p class={eyebrowClass}>{about.eyebrow}</p>
          <h2 class="mt-3 font-display text-3xl font-medium sm:text-4xl">{about.heading}</h2>
          <div class="mt-5 space-y-4 text-[16px] leading-relaxed text-muted">
            {about.paragraphs.map((para) => <p>{para}</p>)}
          </div>
        </div>

        <div class="space-y-12" data-reveal>
          <div>
            <h3 class="font-condensed text-[14px] font-bold uppercase tracking-[0.12em] text-muted">Education</h3>
            <div class="mt-5 space-y-6">
              {
                education.degrees.map((ed) => (
                  <div class="flex flex-col gap-1 border-l-2 border-line pl-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                    <div>
                      <p class="font-semibold text-fg">{ed.school}</p>
                      <p class="text-[14.5px] text-muted">{ed.degree}</p>
                      {education.showCoursework && ed.coursework?.length > 0 && (
                        <p class="mt-1 text-[13px] text-faint">{ed.coursework.join(' · ')}</p>
                      )}
                    </div>
                    <p class="tnum whitespace-nowrap text-[13.5px] text-faint">{ed.years}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <div>
            <h3 class="font-condensed text-[14px] font-bold uppercase tracking-[0.12em] text-muted">Experience</h3>
            <div class="mt-5 space-y-7">
              {
                experience.map((ex) => (
                  <div class="border-l-2 border-line pl-5">
                    <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                      <p class="font-semibold text-fg">{ex.role}</p>
                      <p class="tnum whitespace-nowrap text-[13.5px] text-faint">{ex.years}</p>
                    </div>
                    <p class="text-[14px] text-muted">{ex.org}</p>
                    <ul class="mt-2.5 space-y-1.5">
                      {ex.points.map((pt) => (
                        <li class="relative pl-4 text-[13.5px] leading-relaxed text-muted before:absolute before:left-0 before:top-2 before:h-1 before:w-1 before:rounded-full before:bg-accent">
                          {pt}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Skills ──────────────────────── -->
  <section id="skills" class="scroll-mt-20 border-t border-line/70 bg-panel-2/40">
    <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8 sm:py-24">
      <div class="max-w-2xl" data-reveal>
        <p class={eyebrowClass}>{skills.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-medium sm:text-4xl">{skills.heading}</h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-3" data-reveal>
        {
          skills.groups.map((g) => (
            <div>
              <h3 class="font-condensed text-[14px] font-bold uppercase tracking-[0.12em] text-fg">{g.title}</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {g.items.map((item) => (
                  <li class="rounded-md border border-line bg-panel px-3 py-1.5 text-[13.5px] text-muted">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Work ───────────────────────── -->
  <section id="work" class="scroll-mt-20 border-t border-line/70">
    <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8 sm:py-24">
      <div class="max-w-2xl" data-reveal>
        <p class={eyebrowClass}>{work.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-medium sm:text-4xl">{work.heading}</h2>
        <p class="mt-4 text-[16px] leading-relaxed text-muted">{work.blurb}</p>
      </div>

      <div class="work-grid mt-14 grid grid-cols-1 gap-x-8 gap-y-14 md:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <!-- ───────────────────── Contact (coda) ──────────────────── -->
  <section id="contact" class="scroll-mt-20 border-t border-line/70 bg-panel-2/40">
    <div class="mx-auto max-w-3xl px-5 py-20 text-center sm:px-8 sm:py-24" data-reveal>
      <p class={`${eyebrowClass} before:mx-auto`}>{contact.eyebrow}</p>
      <h2 class="mt-3 font-display text-3xl font-medium sm:text-4xl">{contact.heading}</h2>
      <p class="mx-auto mt-4 max-w-xl text-[16px] leading-relaxed text-muted">{contact.blurb}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 rounded-lg bg-navy px-5 py-2.5 text-[14.5px] font-semibold text-white transition-transform hover:-translate-y-0.5"
        >
          {site.email}
        </a>
        <a
          href={site.github}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-2.5 text-[14.5px] font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
        >
          GitHub
        </a>
      </div>
    </div>
  </section>
</Base>
